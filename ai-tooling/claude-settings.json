{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scripts/protect-files.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scripts/security-check.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/scripts/no-comments-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scripts/log-commands.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scripts/repo-scope-guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/scripts/no-comments-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scripts/format-on-edit.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/scripts/notify.sh 'Claude needs your input' 'Glass' 'normal'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/scripts/notify.sh 'Task completed' 'Ping' 'low'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scripts/validate-environment.py",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scripts/validate-prompt.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "GIT_AUTHOR_NAME": "Nicholas' Clanker",
    "GIT_AUTHOR_EMAIL": "clanker@nicholasgriffin.co.uk",
    "GIT_COMMITTER_NAME": "Nicholas' Clanker",
    "GIT_COMMITTER_EMAIL": "clanker@nicholasgriffin.co.uk",
    "AI_GIT_ALLOWED_OWNERS": "nicholasgriffintn",
    "GITHUB_APP_ID": "4717035",
    "GITHUB_APP_PRIVATE_KEY_PATH": "~/.config/machine-setup/nicholas-clanker.2026-08-25.private-key.pem",
    "GIT_CONFIG_COUNT": "5",
    "GIT_CONFIG_KEY_0": "commit.gpgsign",
    "GIT_CONFIG_VALUE_0": "false",
    "GIT_CONFIG_KEY_1": "credential.helper",
    "GIT_CONFIG_VALUE_1": "",
    "GIT_CONFIG_KEY_2": "credential.https://github.com.helper",
    "GIT_CONFIG_VALUE_2": "!~/.claude/hooks/scripts/git-credential-clanker.py",
    "GIT_CONFIG_KEY_3": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_3": "git@github.com:",
    "GIT_CONFIG_KEY_4": "url.https://github.com/.insteadOf",
    "GIT_CONFIG_VALUE_4": "ssh://git@github.com/"
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true
}
