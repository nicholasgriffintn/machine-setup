{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/scripts/protect-files.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/scripts/security-check.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/scripts/no-comments-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/scripts/log-commands.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/scripts/repo-scope-guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/scripts/no-comments-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/scripts/format-on-edit.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/scripts/validate-environment.py",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/scripts/validate-prompt.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.codex/hooks/scripts/notify.sh 'Task completed' 'Ping' 'low'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
