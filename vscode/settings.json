{
  // Baseline VS Code settings, applied to stable, Insiders and every profile
  // by scripts/sync-vscode.py. Keys listed here are owned by this repo;
  // anything else in the live settings.json is left alone.

  // The theme reset every few days because nothing pinned it and macOS's
  // appearance was a second, invisible owner via autoDetectColorScheme.
  "window.autoDetectColorScheme": false,
  "window.autoDetectHighContrast": false,
  "window.systemColorTheme": "dark",
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.preferredDarkColorTheme": "Catppuccin Mocha",
  "workbench.preferredLightColorTheme": "Catppuccin Mocha",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.productIconTheme": "Default",
  "workbench.fontAliasing": "antialiased",
  "catppuccin.accentColor": "mauve",
  "catppuccin.italicComments": true,
  "catppuccin.italicKeywords": false,
  "catppuccin.boldKeywords": true,
  "catppuccin.extraBordersEnabled": false,
  "catppuccin.workbenchMode": "default",
  "catppuccin.bracketMode": "rainbow",

  "editor.fontFamily": "'FantasqueSansM Nerd Font Mono', 'Fira Code', 'Dank Mono', Menlo, monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.6,
  // VS Code has no workbench-wide font setting, so BBC Reith Sans is applied
  // to every surface that takes a prose font.
  "chat.fontFamily": "'BBC Reith Sans', -apple-system, BlinkMacSystemFont, sans-serif",
  "chat.fontSize": 13,
  "chat.editor.fontFamily": "'FantasqueSansM Nerd Font Mono', 'Fira Code', Menlo, monospace",
  "markdown.preview.fontFamily": "'BBC Reith Sans', -apple-system, BlinkMacSystemFont, sans-serif",
  "markdown.preview.fontSize": 14,
  "markdown.preview.lineHeight": 1.6,
  "notebook.markup.fontFamily": "'BBC Reith Sans', -apple-system, BlinkMacSystemFont, sans-serif",
  "notebook.output.fontFamily": "'FantasqueSansM Nerd Font Mono', Menlo, monospace",
  "scm.inputFontFamily": "'BBC Reith Sans', -apple-system, BlinkMacSystemFont, sans-serif",
  "debug.console.fontFamily": "'FantasqueSansM Nerd Font Mono', Menlo, monospace",
  "debug.console.fontSize": 13,

  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [100],
  "editor.wordWrap": "off",
  "editor.suggestSelection": "first",
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.accessibilitySupport": "off",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.test.ts, ${capture}.spec.ts",
    "*.tsx": "${capture}.ts, ${capture}.test.tsx, ${capture}.spec.tsx, ${capture}.module.css",
    "package.json": "package-lock.json, pnpm-lock.yaml, yarn.lock, .npmrc, .nvmrc, biome.json, .oxlintrc.json, tsconfig*.json, vitest.config.*, vite.config.*",
    "pyproject.toml": "poetry.lock, uv.lock, requirements*.txt, setup.cfg, setup.py, tox.ini, .python-version",
    "mix.exs": "mix.lock, .formatter.exs, .tool-versions",
    "Cargo.toml": "Cargo.lock",
    "go.mod": "go.sum",
    "wrangler.toml": "wrangler.jsonc, wrangler.json, .dev.vars*",
    "README.md": "LICENSE, CONTRIBUTING.md, CHANGELOG.md, CODEOWNERS, .editorconfig, renovate.json"
  },
  "breadcrumbs.enabled": true,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 12,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.tree.indent": 14,
  "workbench.startupEditor": "none",
  "workbench.list.smoothScrolling": true,
  "workbench.settings.editor": "json",

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/_build/**": true,
    "**/deps/**": true,
    "**/target/**": true,
    "**/dist/**": true,
    "**/.next/**": true,
    "**/cdk.out/**": true,
    "**/.wrangler/**": true,
    "**/.turbo/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/_build": true,
    "**/deps": true,
    "**/cdk.out": true,
    "**/.next": true,
    "**/.wrangler": true,
    "**/.venv": true,
    "**/*.lock": true,
    "**/pnpm-lock.yaml": true,
    "**/package-lock.json": true,
    "**/poetry.lock": true,
    "**/uv.lock": true
  },
  "search.useIgnoreFiles": true,
  "search.smartCase": true,

  "terminal.integrated.fontFamily": "'FantasqueSansM Nerd Font Mono', 'MesloLGS Nerd Font Mono', Menlo, monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.scrollback": 50000,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.persistentSessionScrollback": 10000,
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "gutter",
  "terminal.integrated.stickyScroll.enabled": true,
  // VS Code's default 4.5 contrast ratio recolours oh-my-posh and Catppuccin
  // output in the integrated terminal.
  "terminal.integrated.minimumContrastRatio": 1,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.tabs.enabled": true,

  "git.autofetch": true,
  "git.pruneOnFetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.mergeEditor": true,
  "git.openRepositoryInParentFolders": "never",
  "git.branchProtection": ["main", "master"],
  "git.branchProtectionPrompt": "alwaysPrompt",
  "git.untrackedChanges": "separate",
  "githubPullRequests.pullBranch": "never",
  "githubPullRequests.createOnPublishBranch": "never",

  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "javascript.updateImportsOnFileMove.enabled": "always",

  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.terminal.activateEnvironment": true,
  "python.createEnvironment.trigger": "off",
  "jupyter.askForKernelRestart": false,

  "elixirLS.dialyzerEnabled": false,
  "elixirLS.fetchDeps": false,
  "elixirLS.suggestSpecs": false,

  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "redhat.telemetry.enabled": false,

  // Only format repos that actually ship a Prettier config -- the rest of the
  // 100+ repos in ~/workspace have their own conventions.
  "prettier.requireConfig": true,

  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "redhat.vscode-yaml", "editor.tabSize": 2, "editor.autoIndent": "keep" },
  "[markdown]": { "editor.defaultFormatter": "yzhang.markdown-all-in-one", "editor.wordWrap": "on", "editor.quickSuggestions": { "other": false } },
  "[elixir]": { "editor.defaultFormatter": "JakeBecker.elixir-ls", "editor.tabSize": 2 },
  "[python]": { "editor.tabSize": 4, "editor.formatOnSave": false },
  "[shellscript]": { "editor.tabSize": 4, "editor.formatOnSave": false },
  "[go]": { "editor.tabSize": 4, "editor.insertSpaces": false },

  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "errorLens.excludeBySource": ["cSpell"],
  "cSpell.language": "en-GB",
  "cSpell.words": [
    "antidote",
    "atuin",
    "belfrage",
    "btop",
    "catppuccin",
    "cloudflare",
    "dotfiles",
    "elixirls",
    "eza",
    "fastfetch",
    "ghostty",
    "growthbook",
    "jsonc",
    "mkcd",
    "oxlint",
    "pnpm",
    "pyproject",
    "ripgrep",
    "sagemaker",
    "wrangler",
    "zoxide",
    "zshrc"
  ],

  "extensions.ignoreRecommendations": true,
  "extensions.autoUpdate": "onlyEnabledExtensions",
  "telemetry.telemetryLevel": "error",
  "update.showReleaseNotes": false,
  "totalTypeScript.hideAllTips": true,
  "totalTypeScript.hideBasicTips": true,

  "chat.mcp.gallery.enabled": true,
  "chat.viewSessions.orientation": "stacked",
  "chat.agent.sandbox.enabled": "on",
  "chat.agent.sandbox.network.allowLocalNetwork": true,
  "chat.agentHost.experimental.mcpToolRouting": true,
  "chat.customizations.copilotConnectors.enabled": true
}
